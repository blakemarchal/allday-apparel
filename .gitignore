# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Environment
.env
.env.local
.env.*.local
!.env.example

# Anything explicitly carrying secrets — credentials, config dumps, key files.
# If you have a real password / token to keep, use a password manager,
# not a file in the repo.
**/secrets/**
**/*.key
**/*.pem
*credentials*
*-secrets.*
secrets.*
# Catch-all for ad-hoc config notes that have caught passwords before.
docs/*.txt

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Drizzle
drizzle/meta/_journal.json.bak

# Docker volume data (defensive — should never be in repo)
data/
pgdata/

# Vercel (we don't deploy to Vercel, but defensive)
.vercel/

# Turbo cache (if added later)
.turbo/
