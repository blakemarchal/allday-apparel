# apps/web — local dev env. Copy to .env.local.
# DATABASE_URL must match the merch-postgres container in infra/docker-compose.yml.
DATABASE_URL=postgresql://merch:merch_dev@127.0.0.1:5433/merch
REDIS_URL=redis://127.0.0.1:6380

# Stripe — test keys until Will's LLC Stripe account is live.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional override; defaults to '2024-12-18.acacia'.
# STRIPE_API_VERSION=2024-12-18.acacia

# Supabase (admin auth only — customers checkout as guests).
# Create a free project at https://supabase.com/dashboard and paste the URL +
# anon key here. The service-role key is for invite/admin-management server
# code; never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build the magic-link callback. Override if behind a proxy.
# Locally, http://admin.localhost:3001 works.
NEXT_PUBLIC_SITE_URL=http://admin.localhost:3001
