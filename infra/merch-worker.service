[Unit]
Description=Allday Merch — BullMQ worker (Stripe events, drop scheduling, email)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/AlldayApparel/packages/workers
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
EnvironmentFile=/opt/AlldayApparel/.env.production
# Loads dotenv from CWD too, but EnvironmentFile above already exports the
# vars to the process, so dotenv is a no-op in production. The `start` script
# (packages/workers/package.json) is `tsx src/main.ts`.
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=merch-worker

MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=multi-user.target
