# Copy to .env.local for local dev. Do not commit real secrets.

# === Database ===
# Local: matches infra/docker-compose.yml. Production: VPS Postgres on :5433.
DATABASE_URL=postgresql://merch:merch_dev@127.0.0.1:5433/merch
POSTGRES_USER=merch
POSTGRES_PASSWORD=merch_dev
POSTGRES_DB=merch

# === Redis (BullMQ queue) ===
REDIS_URL=redis://127.0.0.1:6380

# === Stripe (test mode until Will's LLC account is live) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === Supabase (admin auth only) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Resend (transactional email) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# === Cloudflare R2 (product images) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# === App ===
NODE_ENV=development
# Comma-separated list of hostnames the storefront_host table will be seeded with for local dev.
# In prod, real subdomains. Locally, lvh.me trick or /etc/hosts entries.
DEV_HOSTS=apparel.localhost,character.localhost,admin.localhost

# === Partner payout (Blake's cut) ===
# Basis points: 2000 = 20%, 1500 = 15%, 1000 = 10%. Snapshotted onto payout_accrual at order time.
PARTNER_PAYOUT_PCT_BPS=2000
# Currently only "net_margin" is implemented. Leaving as enum-style for future flexibility.
PARTNER_PAYOUT_BASIS=net_margin
